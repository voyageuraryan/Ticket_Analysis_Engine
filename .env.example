# =============================================================================
# SAP Ticket Triage Assistant — environment template
#
#   copy .env.example .env     (Windows)
#   cp   .env.example .env     (Linux/Mac)
#
# Then fill in the two required keys below. Never commit the real .env —
# it is already listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Google Gemini
# Used for: document + query embeddings, and the user-facing classification LLM.
# Get a key at https://aistudio.google.com/apikey
# Config.validate() fails without this one, even on Groq-only paths.
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional extra Gemini keys — only used by scripts/02c_build_vector_store_multikey.py,
# which rotates across them to build the vector store roughly N times faster.
# GOOGLE_API_KEY_1=
# GOOGLE_API_KEY_2=

# -----------------------------------------------------------------------------
# REQUIRED for bulk jobs — Groq
# Used for: data augmentation, RAFT generation, fast batch evaluation.
# Get a key at https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Backup Groq keys for automatic rotation. When a key hits its rate limit the
# classifier/augmenter/generator advances to the next one instead of aborting.
# Strongly recommended for augmentation and RAFT generation — those are
# thousands of calls and will hit the free-tier limit on a single key.
# Up to 5 backups are read (BACKUP1..BACKUP5).
# GROQ_API_KEY_BACKUP1=
# GROQ_API_KEY_BACKUP2=
# GROQ_API_KEY_BACKUP3=
# GROQ_API_KEY_BACKUP4=
# GROQ_API_KEY_BACKUP5=

# -----------------------------------------------------------------------------
# LLM provider for batch scripts: groq | gemini | ollama
# The Streamlit apps ignore this and always use Gemini for response quality.
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Models
# EMBEDDING_MODEL: the "models/" prefix is required by the google.generativeai
# library. Changing this invalidates every stored vector — delete
# data/embeddings/train_embeddings.pkl and rebuild the store if you change it.
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
TEMPERATURE=0.2
MAX_TOKENS=2048

# Local LLM via Ollama — only used when LLM_PROVIDER=ollama
USE_LOCAL_LLM=false
LOCAL_LLM_MODEL=gemma:2b
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Retrieval
# TOP_K_RETRIEVAL  documents passed to the LLM as context
# RRF_K            Reciprocal Rank Fusion constant; 60 is the standard value
# -----------------------------------------------------------------------------
TOP_K_RETRIEVAL=10
RRF_K=60
SIMILARITY_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
MAX_WORKERS=4

# -----------------------------------------------------------------------------
# Storage paths — relative to the repository root
# -----------------------------------------------------------------------------
VECTOR_STORE_PATH=data/vector_store
COLLECTION_NAME=sap_tickets
RAW_DATA_PATH=data/raw/Historic_Data_CSV.xlsx
PROCESSED_DATA_PATH=data/processed
RAFT_DATA_PATH=data/raft

# -----------------------------------------------------------------------------
# Augmentation targets — rows per module after rebalancing.
# Basis is already the majority class and is left as-is.
# -----------------------------------------------------------------------------
TARGET_BASIS=4302
TARGET_HR_PAYROLL=2000
TARGET_PROCUREMENT=1500
TARGET_CONNECTIONS=1500
TARGET_FICO=1500
TARGET_ABAP=1500

# -----------------------------------------------------------------------------
# Splitting — must sum to 1.0. Keep RANDOM_SEED fixed so runs stay comparable.
# -----------------------------------------------------------------------------
TRAIN_SIZE=0.7
VAL_SIZE=0.15
TEST_SIZE=0.15
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Rate limiting
# API_DELAY_SECONDS: pause between API batches. Groq free tier is ~30 req/min,
# so 2.0 keeps a single key just inside the limit. Lower it only when rotating
# across several keys.
# BATCH_SIZE: texts per embedding call. Gemini accepts up to 100.
# -----------------------------------------------------------------------------
API_DELAY_SECONDS=2.0
BATCH_SIZE=100
